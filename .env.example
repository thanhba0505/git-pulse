# ==============================================================================
# Git Pulse — Root Monorepo Environment Variables
# ==============================================================================

# Node Environment
NODE_ENV=development

# Standard Ecosystem Ports (Prism Hub)
CLIENT_PORT=6100
PORT=6101

# Local PostgreSQL 16 (Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/git_pulse?schema=public

# Security & Secrets
JWT_SECRET=git_pulse_super_secret_jwt_key_2026_prism_ecosystem_min32chars
GITHUB_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
S2S_ENCRYPTION_KEY=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210

# S2S Central Gateway Integration
GATEWAY_URL=http://localhost:5101/api/v1
GATEWAY_SECRET_KEY=dev_gateway_secret_key_change_in_production_32chars

# CORS Whitelist (Comma-separated for local & preview)
CORS_ORIGIN=http://localhost:6100

# Client Public Variables
NEXT_PUBLIC_API_URL=http://localhost:6101/api/v1
NEXT_PUBLIC_GATEWAY_CLIENT_URL=http://localhost:5100
