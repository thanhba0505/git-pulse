datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum GitAuthType {
  OAUTH
  PAT
}

enum AiEngineType {
  GITHUB_MODELS
  GOOGLE_GEMINI
  WEB_LLM
}

enum AiProviderType {
  GOOGLE_GEMINI
}

enum TokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
  NEEDS_REAUTH
}

model User {
  id         String            @id @default(uuid())
  username   String            @unique
  email      String?           @unique
  avatarUrl  String?
  role       Role              @default(USER)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  gitAccounts   GitAccount[]
  aiConnections AiConnection[]
  settings      UserSettings?
  reports       ReportHistory[]
  bookmarks     GitRepoBookmark[]
  trackingTasks TrackingTask[]

  @@map("users")
}

model AiConnection {
  id              String         @id @default(uuid())
  userId          String         @map("user_id")
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider        AiProviderType @default(GOOGLE_GEMINI)
  label           String         @db.VarChar(80)
  encryptedKey    String         @map("encrypted_key")
  keyIv           String         @map("key_iv")
  keyTag          String         @map("key_tag")
  keyVersion      Int            @default(1) @map("key_version")
  maskedKey       String         @map("masked_key") @db.VarChar(32)
  availableModels Json?          @map("available_models")
  status          TokenStatus    @default(ACTIVE)
  isActive        Boolean        @default(true) @map("is_active")
  lastVerifiedAt  DateTime?      @map("last_verified_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@index([userId, provider])
  @@map("ai_connections")
}

model GitAccount {
  id                 String       @id @default(uuid())
  userId             String
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  authType           GitAuthType  @default(OAUTH)
  encryptedToken     String       // AES-256-GCM encrypted token
  tokenIv            String       // Initialization vector for AES-256-GCM
  tokenTag           String       // Auth tag for AES-256-GCM
  keyVersion         Int          @default(1) // Key versioning for rotation
  gitUsername        String
  gitId              String?
  gitAvatar          String?
  scopes             String[]     @default([])
  hasExcessiveScopes Boolean      @default(false) // Warning flag for dangerous scopes
  tokenStatus        TokenStatus  @default(ACTIVE)
  isActive           Boolean      @default(true)
  expiresAt          DateTime?    // Token expiration for Fine-Grained PAT
  lastSyncAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([userId, gitUsername])
  @@index([userId, isActive])
  @@map("git_accounts")
}

model TokenAuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // PAT_SAVE | OAUTH_SAVE | ACTIVITY_FETCH | AI_SUMMARIZE | DISCONNECT | TOKEN_REVOKED
  ipAddress String?
  userAgent String?
  status    String   // SUCCESS | FAILED
  details   String?  // Context info without secret tokens
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("token_audit_logs")
}

model UserSettings {
  id                  String       @id @default(uuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAiEngine     AiEngineType @default(GITHUB_MODELS)
  githubModelName     String       @default("gpt-4o-mini")
  webLlmModelName     String       @default("Llama-3.2-1B-Instruct-q4f16_1-MLC")
  summaryTone         String       @default("STANDUP_BULLETS")
  language            String       @default("vi")
  autoCopyToClipboard Boolean      @default(true)
  customPrompt        String?      @db.Text
  fetchPreferences    Json?        @map("fetch_preferences")
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("user_settings")
}

model ReportHistory {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  summaryText    String       @db.Text
  prCount        Int          @default(0)
  commitCount    Int          @default(0)
  metadata       Json?
  aiEngineUsed   AiEngineType
  modelName      String
  dateRangeStart DateTime
  dateRangeEnd   DateTime
  createdAt      DateTime     @default(now())

  @@map("report_histories")
}

model GitRepoBookmark {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoFullName String
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([userId, repoFullName])
  @@map("git_repo_bookmarks")
}

model TrackingTask {
  id          String             @id @default(uuid())
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String             @db.VarChar(160)
  color       String             @default("sky") @db.VarChar(32)
  isCompleted Boolean            @default(false) @map("is_completed")
  completedAt DateTime?          @map("completed_at")
  items       TrackingTaskItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, updatedAt])
  @@map("tracking_tasks")
}

model TrackingTaskItem {
  id        String       @id @default(uuid())
  taskId    String
  task      TrackingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  repo      String       @db.VarChar(255)
  prNumber  Int          @map("pr_number")
  title     String       @db.VarChar(300)
  prUrl     String       @db.VarChar(500)
  state     String       @default("open") @db.VarChar(32)
  ownerType String       @default("personal") @map("owner_type") @db.VarChar(32)
  addedAt   DateTime     @default(now()) @map("added_at")

  @@unique([taskId, repo, prNumber])
  @@map("tracking_task_items")
}

model ServiceConnection {
  id             String    @id @default(uuid())
  slug           String    @unique @db.VarChar(64)
  name           String    @db.VarChar(128)
  domain         String    @db.VarChar(255)
  apiPrefix      String    @default("/api/v1") @map("api_prefix") @db.VarChar(64)
  apiKey         String?   @map("api_key") @db.VarChar(255)
  incomingSecret String?   @map("incoming_secret") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  timeoutMs      Int       @default(10000) @map("timeout_ms")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("service_connections")
}
