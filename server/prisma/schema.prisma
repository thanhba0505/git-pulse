datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum GitAuthType {
  OAUTH
  PAT
}

enum AiEngineType {
  GITHUB_MODELS
  WEB_LLM
}

enum TokenStatus {
  ACTIVE
  EXPIRED
  REVOKED
  NEEDS_REAUTH
}

model User {
  id         String            @id @default(uuid())
  username   String            @unique
  email      String?           @unique
  avatarUrl  String?
  role       Role              @default(USER)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  gitAccount GitAccount?
  settings   UserSettings?
  reports    ReportHistory[]
  bookmarks  GitRepoBookmark[]

  @@map("users")
}

model GitAccount {
  id                 String       @id @default(uuid())
  userId             String       @unique
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  authType           GitAuthType  @default(OAUTH)
  encryptedToken     String       // AES-256-GCM encrypted token
  tokenIv            String       // Initialization vector for AES-256-GCM
  tokenTag           String       // Auth tag for AES-256-GCM
  keyVersion         Int          @default(1) // Key versioning for rotation
  gitUsername        String
  gitId              String?
  gitAvatar          String?
  scopes             String[]     @default([])
  hasExcessiveScopes Boolean      @default(false) // Warning flag for dangerous scopes
  tokenStatus        TokenStatus  @default(ACTIVE)
  expiresAt          DateTime?    // Token expiration for Fine-Grained PAT
  lastSyncAt         DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@map("git_accounts")
}

model TokenAuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String   // PAT_SAVE | OAUTH_SAVE | ACTIVITY_FETCH | AI_SUMMARIZE | DISCONNECT | TOKEN_REVOKED
  ipAddress String?
  userAgent String?
  status    String   // SUCCESS | FAILED
  details   String?  // Context info without secret tokens
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("token_audit_logs")
}

model UserSettings {
  id                  String       @id @default(uuid())
  userId              String       @unique
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultAiEngine     AiEngineType @default(GITHUB_MODELS)
  githubModelName     String       @default("gpt-4o-mini")
  webLlmModelName     String       @default("Llama-3.2-1B-Instruct-q4f16_1-MLC")
  summaryTone         String       @default("STANDUP_BULLETS")
  language            String       @default("vi")
  autoCopyToClipboard Boolean      @default(true)
  customPrompt        String?      @db.Text
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("user_settings")
}

model ReportHistory {
  id             String       @id @default(uuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  summaryText    String       @db.Text
  prCount        Int          @default(0)
  commitCount    Int          @default(0)
  metadata       Json?
  aiEngineUsed   AiEngineType
  modelName      String
  dateRangeStart DateTime
  dateRangeEnd   DateTime
  createdAt      DateTime     @default(now())

  @@map("report_histories")
}

model GitRepoBookmark {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  repoFullName String
  isFavorite   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@unique([userId, repoFullName])
  @@map("git_repo_bookmarks")
}

model ServiceConnection {
  id             String    @id @default(uuid())
  slug           String    @unique @db.VarChar(64)
  name           String    @db.VarChar(128)
  domain         String    @db.VarChar(255)
  apiPrefix      String    @default("/api/v1") @map("api_prefix") @db.VarChar(64)
  apiKey         String?   @map("api_key") @db.VarChar(255)
  incomingSecret String?   @map("incoming_secret") @db.VarChar(255)
  isActive       Boolean   @default(true) @map("is_active")
  timeoutMs      Int       @default(10000) @map("timeout_ms")
  metadata       Json?
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("service_connections")
}
